{
    "description": "BMS settings for Perth demo \u2014 centred on Perth CBD, WA, Australia.",
    "location": "perth",
    "system": {
        "defaultLatitude": -31.9505,
        "defaultLongitude": 115.8605,
        "fallbackLatitude": -31.9505,
        "fallbackLongitude": 115.8605,
        "defaultZoom": 10,
        "zoneName": "Perth / CBD"
    },
    "dataLayers": {
        "layersFile": "bms-data-layers.json"
    },
    "routes": {
        "defaultRoute": ""
    },
    "connectors": {
        "json-file": {
            "filePaths": [
                "connectors/json/demo_objects.json"
            ],
            "watchFile": false,
            "pollInterval": 0
        },
        "gtfs": {
            "sourcesFile": "connectors/gtfs/gtfs_sources_aus.json",
            "enabled": false
        },
        "ais": {
            "configFile": "connectors/ais/ais_config_aus.json",
            "enabled": false
        },
        "adsb": {
            "configFile": "connectors/adbs/adsb_config_aus.json",
            "enabled": false
        },
        "cot": {
            "configFile": "connectors/cot/cot_config.json"
        },
        "spx": {
            "configFile": "connectors/spx/spx_config.json"
        },
        "sapient": {
            "configFile": "connectors/sapient/sapient_config.json"
        }
    }
}
