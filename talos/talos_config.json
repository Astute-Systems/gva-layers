{
    "description": "BMS settings for Eurosatory 2026 \u2014 Paris Nord Villepinte Exhibition Centre.",
    "location": "paris",
    "system": {
        "defaultLatitude": 48.9714,
        "defaultLongitude": 2.5254,
        "fallbackLatitude": 48.9714,
        "fallbackLongitude": 2.5254,
        "defaultZoom": 10,
        "zoneName": "Paris Nord Villepinte",
        "callsign": "EUROSATORY"
    },
    "dataLayers": {
        "layersFile": "bms-data-layers.json"
    },
    "routes": {
        "defaultRoute": ""
    },
    "connectors": {
        "json-file": {
            "filePaths": [
                "connectors/json/demo_objects.json",
                "connectors/json/adsb_recorded_objects.json",
                "connectors/json/ais_recorded_objects.json"
            ],
            "watchFile": false,
            "pollInterval": 0
        },
        "gtfs": {
            "enabled": false
        },
        "ais": {
            "enabled": false
        },
        "adsb": {
            "configFile": "connectors/adbs/adsb_config.json",
            "enabled": false
        },
        "cot": {
            "configFile": "connectors/cot/cot_config.json"
        }
    },
    "display": {
        "mapSource": "Esri - World Imagery",
        "layers": {
            "symbols": true,
            "routes": true,
            "airports": false,
            "airspaces": false,
            "navaids": false,
            "bullseyes": true,
            "geofences": true,
            "cameras": true,
            "maritimeZones": false,
            "shippingLanes": false,
            "ports": false,
            "maritimeNavAids": false,
            "weatherRadar": false,
            "clouds": false
        }
    }
}
